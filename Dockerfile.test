# Тесты и линтер без железа: docker build -f Dockerfile.test -t minitoo-test . && docker run --rm minitoo-test
# Bluetooth/PipeWire в контейнер не переносятся (см. docs/PORTABILITY.md), здесь только проверка кода.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git liblzo2-2 libportaudio2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
COPY scripts ./scripts
RUN pip install --no-cache-dir -e ".[dev]"
CMD ["python", "-m", "pytest", "-q", "tests"]
